# Apply with a workflows-scoped token (see #7):
#   git apply .github/weekly-unstick-workflow-fixes.patch
#   rm .github/weekly-unstick-workflow-fixes.patch
#   git add -A .github && git commit -m "ci: apply weekly unstick workflow fixes"
#   git push
#
# Note: github-pages now allows `main` (issue #6 resolved on 2026-09-08 deploy).
# Do not reintroduce master-sync for docs.yml. Obsolete `master` branch deleted
# 2026-09-21 after confirming deployment-branch policy allows only `main`.
#
# 2026-09-21: RELEASE_TOKEN still lacks `workflow` scope; Supervisor cannot push
# .github/workflows/* (GH013). Also lacks Issues write (cannot create
# `dependencies` label or comment on #6/#7). Grant fine-grained PAT:
#   - Workflows: Read and write
#   - Issues: Read and write (labels + issue triage)
# then re-run Supervisor or apply this patch once manually.
#
diff --git a/.github/workflows/auto-tag.yml b/.github/workflows/auto-tag.yml
index 783d610..d00d42d 100644
--- a/.github/workflows/auto-tag.yml
+++ b/.github/workflows/auto-tag.yml
@@ -10,6 +10,7 @@ on:
     branches: [main]
     paths:
       - "Cargo.lock"
+      - "Cargo.toml"
   workflow_dispatch:
     inputs:
       bump:
diff --git a/.github/workflows/supervisor.yml b/.github/workflows/supervisor.yml
index 8c48c42..f321834 100644
--- a/.github/workflows/supervisor.yml
+++ b/.github/workflows/supervisor.yml
@@ -33,7 +33,10 @@ jobs:
       - name: Run Cursor Agent
         env:
           CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
+          # RELEASE_TOKEN: Contents + PR write for unstick; needs workflows scope to edit .github/workflows/*.
           GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
+          # Native Actions token can modify workflows when RELEASE_TOKEN lacks that scope.
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           agent -p "$(cat <<'PROMPT'
           You are the weekly unsticker for this repository.
diff --git a/.github/workflows/update-outdated-prs.yml b/.github/workflows/update-outdated-prs.yml
index 7df7b68..6ba40b8 100644
--- a/.github/workflows/update-outdated-prs.yml
+++ b/.github/workflows/update-outdated-prs.yml
@@ -17,6 +17,7 @@ jobs:
     steps:
       - name: Update out-of-date PR branches
         env:
+          RELEASE_TOKEN: ${{ secrets.RELEASE_TOKEN }}
           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           set -euo pipefail
@@ -28,8 +29,12 @@ jobs:
               echo "Updating PR #$number ($author)..."
               case "$author" in
                 dependabot[bot]|app/dependabot)
-                  # Dependabot rebase retriggers checks; GITHUB_TOKEN branch updates do not.
-                  gh pr comment "$number" --repo "$GITHUB_REPOSITORY" --body "@dependabot rebase"
+                  # Dependabot rebase retriggers checks; GITHUB_TOKEN cannot invoke it (see #7).
+                  if [ -z "${RELEASE_TOKEN:-}" ]; then
+                    echo "::warning::RELEASE_TOKEN unset; cannot @dependabot rebase PR #$number"
+                    continue
+                  fi
+                  GH_TOKEN="$RELEASE_TOKEN" gh pr comment "$number" --repo "$GITHUB_REPOSITORY" --body "@dependabot rebase"
                   ;;
                 *)
                   gh pr update-branch "$number" --repo "$GITHUB_REPOSITORY" || {
