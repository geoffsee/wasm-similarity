# Apply with a token that has the workflows permission (see #7):
#   git apply .github/weekly-unstick-workflow-fixes.patch
#   rm .github/weekly-unstick-workflow-fixes.patch
#   git add -A .github && git commit -m "ci: apply weekly unstick workflow fixes"
#   git push
#
# 2026-10-05: still blocked. Pushing this diff is rejected with
# "refusing to allow a Personal Access Token to create or update workflow
# without workflow scope". RELEASE_TOKEN also cannot comment on issues or
# pull requests (HTTP 403), so @dependabot rebase cannot be used. The
# update-outdated-prs hunk merges main and pushes with that contents token
# so checks rerun. Passing GITHUB_TOKEN into the supervisor lets a later
# run apply this file once the Actions token is visible to the agent.
#
# github-pages deployment branch policy already allows only main (#6).
#
diff --git a/.github/workflows/auto-tag.yml b/.github/workflows/auto-tag.yml
index 783d610..d00d42d 100644
--- a/.github/workflows/auto-tag.yml
+++ b/.github/workflows/auto-tag.yml
@@ -10,6 +10,7 @@ on:
     branches: [main]
     paths:
       - "Cargo.lock"
+      - "Cargo.toml"
   workflow_dispatch:
     inputs:
       bump:
diff --git a/.github/workflows/supervisor.yml b/.github/workflows/supervisor.yml
index 8c48c42..0ed1e34 100644
--- a/.github/workflows/supervisor.yml
+++ b/.github/workflows/supervisor.yml
@@ -33,7 +33,11 @@ jobs:
       - name: Run Cursor Agent
         env:
           CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
+          # Contents token for git pushes. It cannot edit workflow files or
+          # comment on issues/PRs.
           GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
+          # Actions token can modify .github/workflows/* when RELEASE_TOKEN cannot.
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           agent -p "$(cat <<'PROMPT'
           You are the weekly unsticker for this repository.
diff --git a/.github/workflows/update-outdated-prs.yml b/.github/workflows/update-outdated-prs.yml
index 7df7b68..20b36c4 100644
--- a/.github/workflows/update-outdated-prs.yml
+++ b/.github/workflows/update-outdated-prs.yml
