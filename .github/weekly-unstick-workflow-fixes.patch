# Apply with a token that has the workflows permission (see #7):
#   git apply .github/weekly-unstick-workflow-fixes.patch
#   rm .github/weekly-unstick-workflow-fixes.patch
#   git add -A .github && git commit -m "ci: apply weekly unstick workflow fixes"
#   git push
#
# 2026-11-16: still blocked on workflow push + issue/PR comments/labels.
# RELEASE_TOKEN cannot create labels, comment/close issues (HTTP 403),
# dispatch workflows (HTTP 403), or push .github/workflows/* (Workflows
# permission missing). Supervisor still does not export GITHUB_TOKEN into
# the agent env (chicken-and-egg with supervisor.yml).
#
# Stuck this week: Dependabot #11 (rust-embed 8.13.0 → 8.14.0) merged via
# Dependabot auto-merge using GITHUB_TOKEN. That merge push does not
# trigger other workflows, so Auto Tag / Test never ran on main and the
# dep bump never shipped. No open PRs; main otherwise green. Refreshed
# Cargo.lock (bumpalo 3.20.4, cc 1.11.2, const-oid 0.10.3) so Auto Tag
# can cut v1.0.22. minicov 0.3.8 still behind 0.3.9 (cargo left unchanged).
# Cargo.toml floors still lag lockfile (wasm-bindgen/serde/rust-embed).
#
# Latent merge risk: ruleset `require_extra_approval_for_unattributed_changes`
# is true with required_approving_review_count 0 — Dependabot PRs may sit
# waiting for a write-access approval even with auto-merge enabled.
# Missing `dependencies` label requested by dependabot.yml.
#
# Maintainer one-shot: grant RELEASE_TOKEN Workflows + Pull requests write,
# or apply this patch with a workflow-scoped token, then delete this file.
#
--- a/.github/workflows/auto-tag.yml
+++ b/.github/workflows/auto-tag.yml
@@ -10,6 +10,7 @@
     branches: [main]
     paths:
       - "Cargo.lock"
+      - "Cargo.toml"
   workflow_dispatch:
     inputs:
       bump:
--- a/.github/workflows/dependabot-auto-merge.yml
+++ b/.github/workflows/dependabot-auto-merge.yml
@@ -25,4 +25,6 @@
         run: gh pr merge --auto --squash "$PR_URL"
         env:
           PR_URL: ${{ github.event.pull_request.html_url }}
-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          # PAT merge so the resulting push triggers Auto Tag / Test.
+          # GITHUB_TOKEN merges do not fire subsequent workflows.
+          GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
--- a/.github/workflows/supervisor.yml
+++ b/.github/workflows/supervisor.yml
@@ -33,7 +33,11 @@
       - name: Run Cursor Agent
         env:
           CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
+          # Contents token for git pushes. It cannot edit workflow files or
+          # comment on issues/PRs.
           GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
+          # Actions token can modify .github/workflows/* when RELEASE_TOKEN cannot.
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           agent -p "$(cat <<'PROMPT'
           You are the weekly unsticker for this repository.
--- a/.github/workflows/update-outdated-prs.yml
+++ b/.github/workflows/update-outdated-prs.yml
@@ -15,21 +15,44 @@
   update:
     runs-on: ubuntu-latest
     steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
