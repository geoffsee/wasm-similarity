# Apply with a token that has the workflows permission (see #7):
#   git apply .github/weekly-unstick-workflow-fixes.patch
#   rm .github/weekly-unstick-workflow-fixes.patch
#   git add -A .github && git commit -m "ci: apply weekly unstick workflow fixes"
#   git push
#
# 2026-10-26: still blocked on workflow push + issue/PR comments.
# Push of applied patch rejected: PAT lacks `workflow` scope / fine-grained
# Workflows permission. RELEASE_TOKEN cannot comment/edit issues or PRs
# (HTTP 403), create labels, or update Pages settings. Supervisor still
# does not export GITHUB_TOKEN into the agent env (chicken-and-egg with
# the supervisor.yml hunk below).
#
# This week otherwise clear: no open Dependabot PRs; cargo + Actions
# Dependabot jobs found nothing to update; main Test/CodeQL/docs green;
# Auto Tag/Release shipped v1.0.18 to npm; cargo outdated clean; Pages
# source is main (issue #6 deploy symptom cleared).
#
# Latent merge risk: ruleset `require_extra_approval_for_unattributed_changes`
# is true with required_approving_review_count 0 — Dependabot PRs may sit
# waiting for a write-access approval even with auto-merge enabled.
# Missing `dependencies` label requested by dependabot.yml.
#
# Maintainer one-shot: grant RELEASE_TOKEN Workflows + Pull requests write,
# or apply this patch with a workflow-scoped token, then delete this file.
#
diff --git a/.github/workflows/auto-tag.yml b/.github/workflows/auto-tag.yml
index 783d610..d00d42d 100644
--- a/.github/workflows/auto-tag.yml
+++ b/.github/workflows/auto-tag.yml
@@ -10,6 +10,7 @@ on:
     branches: [main]
     paths:
       - "Cargo.lock"
+      - "Cargo.toml"
   workflow_dispatch:
     inputs:
       bump:
diff --git a/.github/workflows/supervisor.yml b/.github/workflows/supervisor.yml
index 8c48c42..0ed1e34 100644
--- a/.github/workflows/supervisor.yml
+++ b/.github/workflows/supervisor.yml
@@ -33,7 +33,11 @@ jobs:
       - name: Run Cursor Agent
         env:
           CURSOR_API_KEY: ${{ secrets.CURSOR_API_KEY }}
+          # Contents token for git pushes. It cannot edit workflow files or
+          # comment on issues/PRs.
           GH_TOKEN: ${{ secrets.RELEASE_TOKEN }}
+          # Actions token can modify .github/workflows/* when RELEASE_TOKEN cannot.
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           agent -p "$(cat <<'PROMPT'
           You are the weekly unsticker for this repository.
diff --git a/.github/workflows/update-outdated-prs.yml b/.github/workflows/update-outdated-prs.yml
index 7df7b68..20b36c4 100644
--- a/.github/workflows/update-outdated-prs.yml
+++ b/.github/workflows/update-outdated-prs.yml
@@ -15,21 +15,44 @@ jobs:
   update:
     runs-on: ubuntu-latest
     steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+        with:
+          fetch-depth: 0
+          token: ${{ secrets.RELEASE_TOKEN }}
+
       - name: Update out-of-date PR branches
         env:
           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
         run: |
           set -euo pipefail
 
+          git config user.name "github-actions[bot]"
+          git config user.email "github-actions[bot]@users.noreply.github.com"
+
           gh pr list --repo "$GITHUB_REPOSITORY" --base main --state open \
-            --json number,author,isDraft,mergeStateStatus \
-            --jq '.[] | select(.isDraft|not) | select(.mergeStateStatus == "BEHIND") | "\(.number)\t\(.author.login)"' \
-          | while IFS=$'\t' read -r number author; do
+            --json number,author,isDraft,mergeStateStatus,headRefName \
+            --jq '.[] | select(.isDraft|not) | select(.mergeStateStatus == "BEHIND") | "\(.number)\t\(.author.login)\t\(.headRefName)"' \
+          | while IFS=$'\t' read -r number author head; do
               echo "Updating PR #$number ($author)..."
               case "$author" in
                 dependabot[bot]|app/dependabot)
-                  # Dependabot rebase retriggers checks; GITHUB_TOKEN branch updates do not.
-                  gh pr comment "$number" --repo "$GITHUB_REPOSITORY" --body "@dependabot rebase"
+                  # @dependabot rebase needs a user who can comment. RELEASE_TOKEN
+                  # cannot (pull-request comments return 403). GITHUB_TOKEN
+                  # update-branch succeeds but does not retrigger checks.
+                  # Merge main and push with the checkout token so CI runs.
+                  if ! git fetch origin "$head"; then
+                    echo "Skipped PR #$number (fetch failed)"
+                    continue
+                  fi
+                  git checkout --detach "origin/$head"
+                  if git merge origin/main --no-edit; then
+                    git push origin "HEAD:$head" || echo "Skipped PR #$number (push failed)"
+                  else
+                    echo "Skipped PR #$number (merge conflicts)"
+                    git merge --abort || true
+                  fi
+                  git checkout main
                   ;;
                 *)
                   gh pr update-branch "$number" --repo "$GITHUB_REPOSITORY" || {
